# Host tests for the HelikonDB reader; fixture generated by the reference tool.

CC ?= cc
CFLAGS := -O2 -g -std=c99 -Wall -Wextra -Werror -Wconversion -Wshadow \
          -Wundef -Wpointer-arith -DHELIKON_HOST_TEST \
          -I../../firmware/db -I../../firmware/lib
OUT := ../../build/musicdb
TEST := $(OUT)/test_hdb
SAN := $(OUT)/test_hdb_san
FIXTURE := $(OUT)/fixture.hdb

.PHONY: test real sanitize clean

test: $(TEST) $(FIXTURE)
	$(TEST) $(FIXTURE)

real: $(TEST) $(FIXTURE)
	@test -n "$(REAL)" || (echo "usage: make real REAL=/path/music.hdb" && exit 2)
	$(TEST) $(FIXTURE) "$(REAL)"

sanitize: $(SAN) $(FIXTURE)
	$(SAN) $(FIXTURE) $(if $(REAL),"$(REAL)",)

$(TEST): test_hdb.c ../../firmware/db/hdb.c ../../firmware/db/hdb.h \
         ../../firmware/lib/crc32.c ../../firmware/lib/mem.c
	@mkdir -p $(OUT)
	$(CC) $(CFLAGS) -o $@ test_hdb.c ../../firmware/db/hdb.c \
	      ../../firmware/lib/crc32.c ../../firmware/lib/mem.c \
	      ../../firmware/lib/string.c

$(SAN): test_hdb.c ../../firmware/db/hdb.c ../../firmware/db/hdb.h \
       ../../firmware/lib/crc32.c ../../firmware/lib/mem.c \
       ../../firmware/lib/string.c
	@mkdir -p $(OUT)
	$(CC) $(CFLAGS) -fsanitize=address,undefined -fno-omit-frame-pointer \
	      -o $@ test_hdb.c ../../firmware/db/hdb.c \
	      ../../firmware/lib/crc32.c ../../firmware/lib/mem.c \
	      ../../firmware/lib/string.c

$(FIXTURE): ../../tools/hdb_build.py
	@mkdir -p $(OUT)
	python3 ../../tools/hdb_build.py fixture --out $@

clean:
	rm -rf $(OUT)
